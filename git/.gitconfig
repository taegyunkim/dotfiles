[push]
	default = current
[core]
	excludesFile = ~/.gitignore
  ignorecase = false
[alias]
  tree = log --graph --decorate --pretty=oneline --abbrev-commit
[color]
	branch = auto
	diff = auto
	interactive = auto
	status = auto
[fetch]
	prune = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[diff]
  ignoreSubmodules = dirty
[pull]
  rebase = true
[init]
	defaultBranch = main
[user]
	name = Taegyun Kim
	email = k.taegyun@gmail.com

# Datadog work overlay (DataDog + ddoghq orgs): URL routing, work identity,
# and per-org signing keys, applied only to repos with a matching remote.
# Requires git >= 2.36 for includeIf hasconfig. See git/gitconfig-github.
[include]
	path = ~/.dotfiles/git/gitconfig-github
