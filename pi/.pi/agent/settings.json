{
  "lastChangelogVersion": "0.85.1",
  "defaultProvider": "ai-gw-openai",
  "defaultModel": "openai/gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "theme": "light",
  "powerline": {
    "context": {
      "format": "percent"
    },
    "customItems": [
      {
        "id": "github-pr",
        "statusKey": "github-pr",
        "position": "left",
        "selfColorize": true,
        "hideWhenMissing": true
      }
    ],
    "layout": {
      "left": [
        "git",
        "custom:github-pr",
        "context_pct",
        "cost",
        "model",
        "thinking",
        "shell_mode",
        "queue",
        "cache_read",
        "path"
      ]
    },
    "preset": "default",
    "disabledSegments": [
      "path"
    ]
  },
  "packages": [
    "~/dd/datadog-pi-packages/packages/confluence-cli",
    "~/dd/datadog-pi-packages/packages/compaction-continue",
    "~/dd/datadog-pi-packages/packages/refresh-models",
    "~/dd/datadog-pi-packages/packages/notifications",
    "~/dd/datadog-pi-packages/packages/mcp-port-forward",
    "~/dd/datadog-pi-packages/packages/dd-pi-packages-sync",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:pi-powerline-footer",
    "npm:pi-mcp-adapter@2.11.0"
  ]
}
